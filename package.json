    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.3",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
